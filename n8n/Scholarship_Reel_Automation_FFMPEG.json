    },
    {
      "parameters": {
        "jsCode": "const musicUrl = (\n  $json.musicUrl ||\n  $json.music_url ||\n  ($('Select Random Music').item.json || {}).musicUrl ||\n  ($('Select Random Music').item.json || {}).music_url ||\n  ''\n).toString().trim();\n\nconst clipNode = $('Select Random Clip').item.json;\nconst sheet = $('Get Pending Scholarship').item.json;\n\nconst videoUrls = Array.isArray(clipNode.videoUrls) && clipNode.videoUrls.length\n  ? clipNode.videoUrls\n  : (clipNode.videoUrl ? [clipNode.videoUrl] : []);\n\nif (!musicUrl) {\n  throw new Error('No musicUrl. Check Drive Music folder has .mp3 files.');\n}\nif (!videoUrls.length) throw new Error('No videoUrls');\n\nlet ai = $('AI Content').item.json.output?.[0]?.content?.[0]?.text || $('AI Content').item.json;\nif (typeof ai === 'string') {\n  try { ai = JSON.parse(ai); } catch (e) { ai = {}; }\n}\n\nconst scenes = Array.isArray(ai.video_scenes) ? ai.video_scenes : [];\nconst sceneText = (n) => (scenes.find((s) => Number(s.scene) === n)?.text || '').toString().trim();\n\nconst clean = (v, max) => (v || '').toString().replace(/\\s+/g, ' ').trim().slice(0, max);\nconst dangling = new Set(['a','an','the','in','on','at','to','for','of','and','or','with','from']);\n\nconst completeLine = (v, max = 42) => {\n  let t = clean(v, max + 10);\n  if (!t) return '';\n  if (t.length > max) {\n    t = t.slice(0, max + 1);\n    if (t.includes(' ')) t = t.slice(0, t.lastIndexOf(' '));\n  }\n  let words = t.split(/\\s+/).filter(Boolean);\n  while (words.length && dangling.has(words[words.length - 1].toLowerCase().replace(/[.,!?]/g, ''))) {\n    words.pop();\n  }\n  return words.join(' ');\n};\n\nconst country = completeLine(sheet['Host Country'] || '', 28);\nconst university = completeLine(sheet['University'] || '', 40);\nconst degree = completeLine(sheet['Degree Type'] || '', 36);\nconst fieldRaw = clean(sheet['Field of Study'] || '', 60);\nconst fieldShort = completeLine((fieldRaw.split(/[,/|]/)[0] || fieldRaw), 30);\nconst deadline = completeLine(sheet['Deadline'] || '', 28);\nconst benefitRaw = completeLine(\n  sheet['Scholarship Type'] || ai.hook || sceneText(5) || '',\n  40\n);\n\nconst fromScenes = scenes\n  .map((s) => completeLine(s.text, 42))\n  .filter(Boolean);\n\n// Preferred structured slides (complete ideas)\nconst structured = [];\nstructured.push(\n  completeLine(\n    ai.hook || ai.headline || sceneText(1) || (country ? `Fully Funded Scholarships in ${country}` : 'Fully Funded Scholarships'),\n    42\n  )\n);\nif (university) structured.push(university);\nelse if (ai.university_line) structured.push(completeLine(ai.university_line, 40));\n\nif (degree) structured.push(degree);\nelse if (ai.audience_line) structured.push(completeLine(ai.audience_line, 36));\n\nif (fieldShort) structured.push(completeLine(ai.field_line || `Field: ${fieldShort}`, 40));\nelse if (ai.field_line) structured.push(completeLine(ai.field_line, 40));\n\nif (benefitRaw && !/fully funded/i.test(benefitRaw)) structured.push(benefitRaw);\nelse if (sceneText(5)) structured.push(completeLine(sceneText(5), 40));\n\nif (deadline) structured.push(completeLine(`Deadline: ${deadline}`, 40));\n\nconst cta = completeLine(ai.cta || sceneText(7) || sceneText(6) || 'Apply Now', 36) || 'Apply Now';\nstructured.push(cta);\n\n// Unique non-empty slides, max 6\nconst texts = [];\nconst seen = new Set();\nfor (const line of [...structured, ...fromScenes]) {\n  const key = (line || '').toLowerCase();\n  if (!line || seen.has(key)) continue;\n  if (dangling.has(key.split(/\\s+/).pop())) continue;\n  seen.add(key);\n  texts.push(line);\n  if (texts.length >= 6) break;\n}\nwhile (texts.length < 3) texts.push('Follow for more scholarships');\n\nconst uniqueUrls = [];\nfor (const u of videoUrls) {\n  if (u && !uniqueUrls.includes(u)) uniqueUrls.push(u);\n}\nwhile (uniqueUrls.length < texts.length && videoUrls.length) {\n  uniqueUrls.push(videoUrls[uniqueUrls.length % videoUrls.length]);\n}\n\nconst hook = texts[0];\nconst script = texts[Math.min(1, texts.length - 1)];\nconst ctaOut = texts[texts.length - 1];\nconst bio = clean(ai.bio || ai.profile_bio || '', 150);\n\nconst payload = {\n  video_url: uniqueUrls[0],\n  video_urls: uniqueUrls.slice(0, texts.length),\n  music_url: musicUrl,\n  texts,\n  hook,\n  script,\n  cta: ctaOut,\n  duration_seconds: Math.min(18, Math.max(12, texts.length * 2.5)),\n  music_volume: 0.38,\n};\n\nreturn [{\n  json: {\n    ...payload,\n    video_urls_text: payload.video_urls.join('\\n'),\n    render_body: JSON.stringify(payload),\n    profile_bio: bio,\n    caption: (ai.caption || '').toString().trim(),\n    hashtags: Array.isArray(ai.hashtags) ? ai.hashtags : [],\n    field_of_study: fieldShort,\n  },\n}];\n"
      },
